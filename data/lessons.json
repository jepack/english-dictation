    {
      "id": "g3-home-video-2026-10-14",
      "title": "Learn to Read · Dad's home video",
      "grade": "三年级",
      "date": "2026-10-14",
      "tags": ["课文", "现在进行时", "视频纠音"],
      "note": "完整点读：按课本指读顺序。橙色=需纠正。练法：慢读 → 拆分×2 → 快读。",
      "sourceNote": "视频抽帧还原 · Who is in Dad's home video? (p.27)",
      "items": [
        {
          "id": "s1",
          "kind": "sentence",
          "text": "What are you doing, Dad?",
          "syllables": ["What", "are", "you", "do", "ing", "Dad"],
          "stressNote": "do-ing / Dad 略重",
          "tipsZh": "doing：拆 do / ing，/ˈduːɪŋ/",
          "grammarZh": "What are you doing? 现在进行时问句",
          "corrections": []
        },
        {
          "id": "s2",
          "kind": "sentence",
          "text": "I am making a video.",
          "syllables": ["I", "am", "ma", "king", "a", "vi", "de", "o"],
          "stressNote": "ma-king / VI-de-o",
          "tipsZh": "making：ma / king；video：vi / de / o，重音在 VI",
          "grammarZh": "I am + V-ing",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["video 音节含糊"],
              "coach": "慢一点：video。重音在第一拍：VI-de-o。拆：vi / de / o → video。不要读成「威抖」。再快读整句。"
            }
          ]
        },
        {
          "id": "s3",
          "kind": "sentence",
          "text": "Here is Grandma. She is singing.",
          "syllables": ["Here", "is", "Grand", "ma", "She", "is", "sing", "ing"],
          "stressNote": "Grand-ma / SING-ing",
          "tipsZh": "Grandma：Grand / ma；singing：sing / ing（唱歌，不是 sitting）",
          "grammarZh": "She is + V-ing",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["易与 sitting 混淆"],
              "coach": "慢一点：singing。注意是 sing（唱歌）+ing，不是 sit。拆：sing / ing → singing。跟读两遍再接整句。"
            }
          ]
        },
        {
          "id": "s4",
          "kind": "sentence",
          "text": "Here are Mum and Cherry. They are in the kitchen. They are cooking.",
          "syllables": ["Here", "are", "Mum", "and", "Cher", "ry", "They", "are", "in", "the", "kit", "chen", "They", "are", "cook", "ing"],
          "stressNote": "Mum / Cher-ry / KIT-chen / COOK-ing",
          "tipsZh": "Cherry：Cher / ry；kitchen：kit / chen；cooking：cook / ing",
          "grammarZh": "Here are + 复数；They are + V-ing",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["kitchen 重音、cooking 尾音"],
              "coach": "慢一点：kitchen。重音在前：KIT-chen。再：cooking = cook + ing。拆：kit / chen · cook / ing。整句慢读一次。"
            }
          ]
        },
        {
          "id": "s5",
          "kind": "sentence",
          "text": "Yes, and I am eating.",
          "syllables": ["Yes", "and", "I", "am", "eat", "ing"],
          "stressNote": "EAT-ing",
          "tipsZh": "eating：eat / ing",
          "grammarZh": "",
          "corrections": []
        },
        {
          "id": "s6",
          "kind": "sentence",
          "text": "That is Grandpa. He is in the living room. He is watching TV.",
          "syllables": ["That", "is", "Grand", "pa", "He", "is", "in", "the", "liv", "ing", "room", "He", "is", "watch", "ing", "TV"],
          "stressNote": "Grand-pa / LIV-ing room / WATCH-ing",
          "tipsZh": "Grandpa：Grand / pa；living：liv / ing；watching：watch / ing，ch=/tʃ/",
          "grammarZh": "He is + 地点 / He is + V-ing",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["living room 连读含糊", "watching 易读成 watch-ing 分离不当"],
              "coach": "慢一点：living room。拆：liv / ing · room。再：watching → watch / ing，ch=/tʃ/。整句：He is watching TV。"
            }
          ]
        },
        {
          "id": "s7",
          "kind": "sentence",
          "text": "Go away. I can't see.",
          "syllables": ["Go", "a", "way", "I", "can't", "see"],
          "stressNote": "a-WAY / can't / see",
          "tipsZh": "away：a / way；can't：/kɑːnt/（英）或 /kænt/（美）",
          "grammarZh": "can/can't + 动词原形 see",
          "corrections": []
        },
        {
          "id": "s8",
          "kind": "sentence",
          "text": "I can't see Dad in the video. Let's find him.",
          "syllables": ["I", "can't", "see", "Dad", "in", "the", "vi", "de", "o", "Let's", "find", "him"],
          "stressNote": "can't / Dad / VI-de-o / FIND / him",
          "tipsZh": "video：vi / de / o；find him：him 弱读；Let's = Let us",
          "grammarZh": "主格 he → 宾格 him（找的是他）",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["him 与 he 混淆", "find 尾音"],
              "coach": "慢一点：find him。he（主格）→ him（宾格）。拆：find / him。不要说 find he。再快读整句。"
            }
          ]
        },
        {
          "id": "s9",
          "kind": "sentence",
          "text": "There he is! He is in the garden. He is sleeping.",
          "syllables": ["There", "he", "is", "He", "is", "in", "the", "gar", "den", "He", "is", "sleep", "ing"],
          "stressNote": "There / GAR-den / SLEEP-ing",
          "tipsZh": "garden：gar / den；sleeping：sleep / ing",
          "grammarZh": "There he is! 他在那儿！",
          "corrections": [
            {
              "at": "2026-10-14",
              "issues": ["garden 重音"],
              "coach": "慢一点：garden。重音在前：GAR-den。拆：gar / den → garden。再：sleep / ing → sleeping。整句跟读。"
            }
          ]
        },
        {
          "id": "s10",
          "kind": "word",
          "text": "watch",
          "syllables": ["watch"],
          "stressNote": "单音节 /wɒtʃ/",
          "tipsZh": "Phonics w/wh：watch 的 a 短，ch=/tʃ/",
          "grammarZh": "",
          "corrections": []
        },
        {
          "id": "s11",
          "kind": "word",
          "text": "what",
          "syllables": ["what"],
          "stressNote": "单音节 /wɒt/",
          "tipsZh": "wh 常发 /w/；what 与 watch 对比练",
          "grammarZh": "",
          "corrections": []
        }
      ]
